<?xml version="1.0" encoding="utf-8"?>
<!--
  Bokeya launcher mark: a progress ring (dues being cleared) wrapped around a
  short ledger list. Purely geometric so it stays crisp from 24dp to 512dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring track -->
    <path
        android:strokeWidth="7"
        android:strokeColor="#2EFFFFFF"
        android:strokeLineCap="round"
        android:pathData="M 54,27 A 27,27 0 1 1 53.9,27" />

    <!-- Ring progress: ~255 degrees, emerald gradient -->
    <path
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M 54,27 A 27,27 0 1 1 26.03,60.63">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:strokeColor">
            <gradient
                android:startX="27"
                android:startY="27"
                android:endX="81"
                android:endY="81"
                android:type="linear">
                <item android:color="#FF6EE7B7" android:offset="0" />
                <item android:color="#FF10B981" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ledger lines -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M42.25,42 h25.5 a2.25,2.25 0 0 1 0,4.5 h-25.5 a2.25,2.25 0 0 1 0,-4.5 z" />
    <path
        android:fillColor="#E6FFFFFF"
        android:pathData="M42.25,51.75 h21.5 a2.25,2.25 0 0 1 0,4.5 h-21.5 a2.25,2.25 0 0 1 0,-4.5 z" />
    <path
        android:fillColor="#FF6EE7B7"
        android:pathData="M42.25,61.5 h15.5 a2.25,2.25 0 0 1 0,4.5 h-15.5 a2.25,2.25 0 0 1 0,-4.5 z" />
</vector>
